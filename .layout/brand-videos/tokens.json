{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "bg": {
      "dark":     { "$type": "color", "$value": "#15100b" },
      "surface":  { "$type": "color", "$value": "#231a14" }
    },
    "text": {
      "primary":  { "$type": "color", "$value": "#F5EFE7" },
      "accent":   { "$type": "color", "$value": "#BB9457" }
    },
    "cta": {
      "primary":  { "$type": "color", "$value": "#6F1D1B" },
      "hover":    { "$type": "color", "$value": "#5a1715" }
    },
    "illustration": {
      "strokeLight": { "$type": "color", "$value": "#432818" },
      "shadowLight": { "$type": "color", "$value": "#6F1D1B" },
      "strokeDark":  { "$type": "color", "$value": "#EFE3D2" },
      "shadowDark":  { "$type": "color", "$value": "#432818" },
      "fillGold":    { "$type": "color", "$value": "#BB9457" }
    }
  },
  "font": {
    "ui":      { "$type": "fontFamily", "$value": ["Inter", "system-ui", "-apple-system", "sans-serif"] },
    "display": { "$type": "fontFamily", "$value": ["Playfair Display", "Georgia", "serif"] }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" }
  }
}
